{
	"name": "kirby-icon-field",
	"private": true,
	"license": "MIT",
	"author": "Tobias Möritz",
	"type": "module",
	"scripts": {
		"build": "kirbyup src/index.js",
		"dev": "kirbyup dev src/index.js",
		"format": "oxfmt",
		"lint": "eslint \"src/**/*.{js,vue}\"",
		"lint:fix": "pnpm run lint --fix",
		"playground": "PHP_CLI_SERVER_WORKERS=4 php -S ${HOST:-127.0.0.1}:${PORT:-8000} -t .playground .playground/kirby/router.php",
		"playground:portless": "portless run --name icon-field pnpm playground"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.12.1",
		"kirbyup": "4.0.0-beta.2",
		"oxfmt": "^0.79.0",
		"portless": "^0.15.13",
		"vue-eslint-parser": "^10.4.2"
	},
	"packageManager": "pnpm@12.11.2"
}
